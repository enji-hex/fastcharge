#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

DEV="/dev/sda1"
MNT="/mnt/usb"

mount_usb() {
    mkdir -p "$MNT"
    grep -qs " $MNT " /proc/mounts || mount "$DEV" "$MNT" || return 1
}

start_service() {
    mount_usb || return 1
    
    [ -f "$MNT/xray-route-nft.sh" ] && /bin/sh "$MNT/xray-route-nft.sh" start

    # Register Xray as a supervised procd instance.
    if [ -x "$MNT/xray" ] && [ -f "$MNT/config.json" ]; then
        procd_open_instance "x"
        procd_set_param command "$MNT/xray" run -c "$MNT/config.json"
        procd_set_param respawn
        procd_close_instance
    else
        logger -t xray-service "Xray executable or config missing"
        return 1
    fi
}

stop_service() {
    [ -f "$MNT/xray-route-nft.sh" ] && /bin/sh "$MNT/xray-route-nft.sh"
    grep -qs " $MNT " /proc/mounts && umount "$MNT"
}