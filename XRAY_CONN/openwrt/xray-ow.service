#!/bin/sh /etc/rc.common


# XRAY openwrt service, user external USB as xray storage
# place in /etc/init.d/

START=95
STOP=10
USE_PROCD=1

DEV="/dev/sda1"
MNT="/mnt/usb"

start_service(){
    if ! df | grep "$MNT"; then
        mkdir -p "$MNT"
        mount "$DEV" "$MNT" || return 1
    fi

    [ -f "$MNT/xray" ] && {
        procd_open_instance "x"
        procd_set_param command "$MNT/xray" run -c "$MNT/xray.comfig.json"
        procd_set_param respawn
        procd_close_instance
    }

    [ -f "$MNT/ip.sh" ] && {
        procd_open_instance "s"
        procd_set_param command /bin/sh "$MNT/ip.sh" up
        procd_set_param respawn
        procd_close_instance
    }
}

service_stop(){
    /bin/sh "$MNT/ip.sh" || true
    df | grep -q "$MNT" && umount "$MNT"

}