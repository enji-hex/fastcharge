[Unit]  
Description=FastCharge service 
After=network.target
 
[Service]  
Type=simple
User=root
WorkingDirectory=/root/fastcharge
ExecStart=./.venv/bin/uvicorn main:app \
    --app-dir src \
    --host 0.0.0.0 \
    --port 8000  \
    --ssl-keyfile key.pem \
    --ssl-certfile cert.pem \
    --no-server-header

Restart=always 
RestartSec=5

[Install]  
WantedBy=multi-user.target