{
    "inbounds": [
        {
            "type": "socks",
            "tag": "socks-in",
            "listen": "127.0.0.1",
            "listen_port": 1080,
            "udp": true
        },
        {
            "type": "tun",
            "tag": "tun-in",
            "interface_name": "xray0",
            "mtu": 1280,
            "auto_route": true,
            "strict_route": true,
            "stack": "system"
        }
    ],

    "route": {
        "rules": [
            {
                "protocol": "dns",
                "action": "hijack-dns"
            }
        ]
    },

    "final": "proxy"
}